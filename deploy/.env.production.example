# Copy to deploy/.env and fill in real values.
#   cp .env.production.example .env

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=CHANGE_ME_run_python_-c_"import secrets;print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=vanguard.kizzcross.com.br,178.105.169.230,web,localhost,127.0.0.1
LOG_LEVEL=INFO
SERVE_SPA=true

# --- Database (db service) ---
POSTGRES_DB=vanguard
POSTGRES_USER=vanguard
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# --- CORS / CSRF (same-origin in prod, so the domain itself) ---
CORS_ALLOWED_ORIGINS=https://vanguard.kizzcross.com.br
CSRF_TRUSTED_ORIGINS=https://vanguard.kizzcross.com.br

# --- Seeds (only creates dev users/catalog when empty; set false after first boot) ---
DJANGO_SEED_ON_START=false

# --- TLS behind nginx ---
SECURE_SSL_REDIRECT=true

GUNICORN_WORKERS=3

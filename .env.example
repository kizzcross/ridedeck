# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0
LOG_LEVEL=INFO

# ---- Database ----
POSTGRES_DB=ridedeck
POSTGRES_USER=ridedeck
POSTGRES_PASSWORD=ridedeck
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
CELERY_TASK_ALWAYS_EAGER=false

# ---- CORS / CSRF (frontend origin) ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Seeds ----
DJANGO_SEED_ON_START=true

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000

# ---- Import adapters (TCGCSV / TCGplayer) ----
TCGCSV_BASE_URL=https://tcgcsv.com
TCGCSV_VANGUARD_CATEGORY_ID=57
IMPORT_RATE_LIMIT_PER_SEC=5
